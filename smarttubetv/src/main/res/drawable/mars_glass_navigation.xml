<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient android:angle="90" android:startColor="#D5256BB1" android:endColor="#C012355F"/>
            <stroke android:width="1.5dp" android:color="#FF49B9FF"/>
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient android:angle="90" android:startColor="#D5256BB1" android:endColor="#C012355F"/>
            <stroke android:width="1.5dp" android:color="#FF49B9FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <solid android:color="#7110253E"/>
            <stroke android:width="1dp" android:color="#3349B9FF"/>
        </shape>
    </item>
</selector>
