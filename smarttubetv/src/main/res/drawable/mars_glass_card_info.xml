<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp"/>
            <gradient android:angle="90" android:startColor="#ED174D7B" android:endColor="#E2112B45"/>
            <stroke android:width="1dp" android:color="#665DBDFF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:bottomLeftRadius="12dp" android:bottomRightRadius="12dp"/>
            <gradient android:angle="90" android:startColor="#C7192A45" android:endColor="#E00A1A2F"/>
        </shape>
    </item>
</selector>
