<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:angle="90" android:startColor="#D12C6B9F" android:endColor="#C012314D"/>
            <stroke android:width="1dp" android:color="#B66BCBFF"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <gradient android:angle="90" android:startColor="#C62D6497" android:endColor="#B612304D"/>
            <stroke android:width="1dp" android:color="#9961C7FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp"/>
            <solid android:color="#72132743"/>
            <stroke android:width="1dp" android:color="#295CB0EB"/>
        </shape>
    </item>
</selector>
